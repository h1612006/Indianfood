# Copy this file to ".env" and change the values. Never commit the real .env file.

# Password for the kitchen screen (/admin.html)
ADMIN_PASSWORD=change-me-kitchen-password

# Password for the Postgres database (letters and numbers are safest)
POSTGRES_PASSWORD=change-me-database-password

# Optional: which port to open on this machine (default 3000)
# APP_PORT=3000

# Optional: which app image the server should run (set automatically by the GitHub workflow)
# APP_IMAGE=ghcr.io/h1612006/indianfood:latest
