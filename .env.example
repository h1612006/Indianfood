# Copy this file to ".env" and change the values. Never commit the real .env file.

# Password for the kitchen screen (/admin.html)
ADMIN_PASSWORD=change-me-kitchen-password

# Password for the driver page (/driver.html); use a different password from ADMIN_PASSWORD
DRIVER_PASSWORD=change-me-driver-password

# Password for the Postgres database (letters and numbers are safest)
POSTGRES_PASSWORD=change-me-database-password

# Optional: which port to open on this machine (default 3000)
# APP_PORT=3000

# Optional: which app image the server should run (set automatically by the GitHub workflow)
# APP_IMAGE=ghcr.io/h1612006/indianfood:latest

# Optional: take card payments online (money goes to your bank through Stripe).
# Leave these empty to keep "Card" as a choice customers pay at pickup/delivery.
# See "Take card payments into your bank account" in the README.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The public address of your site, no trailing slash (needed so Stripe sends customers back)
PUBLIC_URL=
